Options -Indexes
ErrorDocument 404 /404.html

# 配置与更新备份目录禁止直接访问（含密钥、代码与数据库副本）
RedirectMatch 404 ^/(config_backups|update_backups)/

<IfModule mod_authz_core.c>
    <FilesMatch "\.(db|db-wal|db-shm|sql|md|ini|toml|bak|tmp|lock)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(db|db-wal|db-shm|sql|md|ini|toml|bak|tmp|lock)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

<IfModule mod_php7.c>
    php_flag display_errors off
</IfModule>
<IfModule mod_php.c>
    php_flag display_errors off
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>